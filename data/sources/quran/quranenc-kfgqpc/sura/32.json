44\u0631\u0648\u062d\u060c \u0648\u062c\u0639\u0644 \u0644\u0643\u0645 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0627\u0633- \u0646\u0639\u0645\u0629 \u0627\u0644\u0633\u0645\u0639 \u0648\u0627\u0644\u0623\u0628\u0635\u0627\u0631 \u064a\u064f\u0645\u064a\u0651\u064e\u0632 \u0628\u0647\u0627 \u0628\u064a\u0646 \u0627\u0644\u0623\u0635\u0648\u0627\u062a \u0648\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0648\u0627\u0644\u0630\u0648\u0627\u062a \u0648\u0627\u0644\u0623\u0634\u062e\u0627\u0635\u060c \u0648\u0646\u0639\u0645\u0629 \u0627\u0644\u0639\u0642\u0644 \u064a\u064f\u0645\u064a\u0651\u064e\u0632 \u0628\u0647\u0627 \u0628\u064a\u0646 \u0627\u0644\u062e\u064a\u0631 \u0648\u0627\u0644\u0634\u0631 \u0648\u0627\u0644\u0646\u0627\u0641\u0639 \u0648\u0627\u0644\u0636\u0627\u0631. \u0642\u0644\u064a\u0644\u0627 \u0645\u0627 \u062a\u0634\u0643\u0631\u0648\u0646 \u0631\u0628\u0643\u0645 \u0639\u0644\u0649 \u0645\u0627 \u0623\u0646\u0639\u0645 \u0628\u0647 \u0639\u0644\u064a\u0643\u0645.","footnotes":null},{"id":"3513","sura":"32","aya":"10","arabic_text":"\u0648\u064e\u0642\u064e\u0627\u0644\u064f\u0648\u0653\u0627\u0652 \u0623\u064e\u0621\u0650\u0630\u064e\u0627 \u0636\u064e\u0644\u064e\u0644\u06e1\u0646\u064e\u0627 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0623\u064e\u0621\u0650\u0646\u0651\u064e\u0627 \u0644\u064e\u0641\u0650\u064a \u062e\u064e\u0644\u06e1\u0642\u0656 \u062c\u064e\u062f\u0650\u064a\u062f\u0650\u06ed\u06da \u0628\u064e\u0644\u06e1 \u0647\u064f\u0645 \u0628\u0650\u0644\u0650\u0642\u064e\u0627\u0653\u0621\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e","translation":"\u0648\u0642\u0627\u0644 \u0627\u0644\u0645\u0634\u0631\u0643\u0648\u0646 \u0628\u0627\u0644\u0644\u0647 \u0627\u0644\u0645\u0643\u0630\u0628\u0648\u0646 \u0628\u0627\u0644\u0628\u0639\u062b: \u0623\u0625\u0630\u0627 \u0635\u0627\u0631\u062a \u0644\u062d\u0648\u0645\u0646\u0627 \u06