62f\u0629\u060c \u062b\u0645 \u062a\u064f\u0631\u062f\u0651\u064f\u0648\u0646 \u0625\u0644\u0649 \u0631\u0628\u0643\u0645\u060c \u0641\u064a\u062c\u0627\u0632\u064a\u0643\u0645 \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0623\u0639\u0645\u0627\u0644\u0643\u0645: \u0625\u0646 \u062e\u064a\u0631\u064b\u0627 \u0641\u062e\u064a\u0631 \u0648\u0625\u0646 \u0634\u0631\u064b\u0627 \u0641\u0634\u0631.","footnotes":null},{"id":"3515","sura":"32","aya":"12","arabic_text":"\u0648\u064e\u0644\u064e\u0648\u06e1 \u062a\u064e\u0631\u064e\u0649\u0670\u0653 \u0625\u0650\u0630\u0650 \u0671\u0644\u06e1\u0645\u064f\u062c\u06e1\u0631\u0650\u0645\u064f\u0648\u0646\u064e \u0646\u064e\u0627\u0643\u0650\u0633\u064f\u0648\u0627\u0652 \u0631\u064f\u0621\u064f\u0648\u0633\u0650\u0647\u0650\u0645\u06e1 \u0639\u0650\u0646\u062f\u064e \u0631\u064e\u0628\u0651\u0650\u0647\u0650\u0645\u06e1 \u0631\u064e\u0628\u0651\u064e\u0646\u064e\u0627\u0653 \u0623\u064e\u0628\u06e1\u0635\u064e\u0631\u06e1\u0646\u064e\u0627 \u0648\u064e\u0633\u064e\u0645\u0650\u0639\u06e1\u0646\u064e\u0627 \u0641\u064e\u0671\u0631\u06e1\u062c\u0650\u0639\u06e1\u0646\u064e\u0627 \u0646\u064e\u0639\u06e1\u0645\u064e\u0644\u06e1 \u0635\u064e\u0670\u0644\u0650\u062d\u064b\u0627 \u0625\u0650\u0646\u0651\u064e\u0627 \u0645\u064f\u0648\u0642\u0650\u0646\u064f\u0648\u0646\u064e","translation":"\u0648\u0644\u0648 \u062a\u0631\u0649 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0645\u062e\u0627\u0637\u0628- \u0625\u0630 \u0627\u0644\u0645\u062c\u0631\u0645\u0648\u0646 \u0627\u0644\u0630\u064a\u0646 \u0623\u0646\u0643\u0631\u0648\u0627 \u0627\u0644\u0628\u0639\u062b \u0642\u062f \u062e\u0641\u0636\u0648\u0627 \u0631\u0624\u0648\u0633\u0647\u0645 \u0639\u0646\u062f \u0631\u0628\u0647\u0645 \u0645\u0646 \u0627\u0644\u062e\u0632\u064a \u0648\u0627\u0644\u0639\u0627\u0631 \u0642\u0627\u0626\u0644\u064a\u0646: \u0631\u0628\u0646\u0627 \u0623\u0628\u0635\u0631\u0646\u0627 \u0642\u0628\u0627\u0626\u062d\u0646\u0627\u060c \u0648\u0633\u0645\u0639\u0646