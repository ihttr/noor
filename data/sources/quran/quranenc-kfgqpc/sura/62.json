0644\u0644\u0630\u064a\u0646 \u062a\u0645\u0633\u0643\u0648\u0627 \u0628\u0627\u0644\u0645\u0644\u0629 \u0627\u0644\u064a\u0647\u0648\u062f\u064a\u0629 \u0627\u0644\u0645\u062d\u0631\u0651\u064e\u0641\u0629: \u0625\u0646 \u0627\u062f\u0651\u064e\u0639\u064a\u062a\u0645- \u0643\u0630\u0628\u064b\u0627- \u0623\u0646\u0643\u0645 \u0623\u062d\u0628\u0627\u0621 \u0627\u0644\u0644\u0647 \u062f\u0648\u0646 \u063a\u064a\u0631\u0643\u0645 \u0645\u0646 \u0627\u0644\u0646\u0627\u0633\u060c \u0641\u062a\u0645\u0646\u0651\u064e\u0648\u0627 \u0627\u0644\u0645\u0648\u062a \u0625\u0646 \u0643\u0646\u062a\u0645 \u0635\u0627\u062f\u0642\u064a\u0646 \u0641\u064a \u0627\u062f\u0651\u0650\u0639\u0627\u0626\u0643\u0645 \u062d\u0628 \u0627\u0644\u0644\u0647 \u0644\u0643\u0645.","footnotes":null},{"id":"5184","sura":"62","aya":"7","arabic_text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u062a\u064e\u0645\u064e\u0646\u0651\u064e\u0648\u06e1\u0646\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u0628\u064e\u062f\u064e\u06e2\u0627 \u0628\u0650\u0645\u064e\u0627 \u0642\u064e\u062f\u0651\u064e\u0645\u064e\u062a\u06e1 \u0623\u064e\u064a\u06e1\u062f\u0650\u064a\u0647\u0650\u0645\u06e1\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0639\u064e\u0644\u0650\u064a\u0645\u064f\u06e2 \u0628\u0650\u0671\u0644\u0638\u0651\u064e\u0670\u0644\u0650\u0645\u0650\u064a\u0646\u064e","translation":"\u0648\u0644\u0627 \u064a\u062a\u0645\u0646\u0649 \u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u064a\u0647\u0648\u062f \u0627\u0644\u0645\u0648\u062a \u0623\u0628\u062f\u064b\u0627 \u0625\u064a\u062b\u0627\u0631\u064b\u0627 \u0644\u0644\u062d\u064a\u0627\u0629 \u0627\u0644\u062f\u0646\u064a\u0627 \u0639\u0644\u0649 \u0627\u0644\u0622\u062e\u0631\u0629\u060c \u0648\u062e\u0648\u0641\u064b\u0627 \u0645\u0646 \u0639\u0642\u0627\u0628 \u0627\u0644\u0644\u0647 \u0644\u0647\u0645\u061b \u0628\u0633\u0628\u0628 \u0645\u0627 \u0642\u062f\u0651\u064e\u0645\u0648\u0647 \u0645\u0646 \u0627\u0644\u0643\u0641\u0631 \u0648\u0633\u0648\u0621 \u0627\u0644\u0641\u0639\u0627\u0644. \u0648\u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0645 \u0628\u0627\u0644\u0638\u0627\u0644\u0645\u064a\u0646\u060c \u0644\u0627 \u064a\u062e\u0641\u0649 \u0639\u0644\u064a\u0647 \u0645\u0646 \u0638\u0644\u0645\u0647\u0645 \u0634\u064a\u0621.","footnotes":null},{"id":"5185","sura":"62","aya":"8","arabic_text":"\u0642\u064f\u0644\u06e1 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064e\u0648\u06e1\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a \u062a\u064e\u0641\u0650\u0631\u0651\u064f\u0648\u0646\u064e \u0645\u0650\u0646\u06e1\u0647\u064f \u0641\u064e\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0645\u064f\u0644\u064e\u0670\u0642\u0650\u064a\u0643\u064f\u0645\u06e1\u06d6 \u062b\u064f\u0645\u0651\u064e \u062a\u064f\u0631\u064e\u062f\u0651\u064f\u0648\u0646\u064e \u0625\u0650\u0644\u064e\u0649\u0670 \u0639\u064e\u0670\u0644\u0650\u0645\u0650 \u0671\u0644\u06e1\u063a\u064e\u064a\u06e1\u0628\u0650 \u0648\u064e\u0671\u0644\u0634\u0651\u064e\u0647\u064e\u0670\u062f\u064e\u0629\u0650 \u0641\u064e\u064a\u064f\u0646\u064e\u0628\u0651\u0650\u0626\u064f\u0643\u064f\u0645 \u0628\u0650\u0645\u064e\u0627 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0645\u064e\u0644\u064f\u0648\u0646\u064e","translation":"\u0642\u0644: \u0625\u0646 \u0627\u0644\u0645\u0648\u062a \u0627\u0644\u0630\u064a \u062a\u0647\u0631\u0628\u0648\u0646 \u0645\u0646\u0647 \u0644\u0627 \u0645\u0641\u0631\u0651\u064e \u0645\u0646\u0647\u060c \u0641\u0625\u0646\u0647 \u0622\u062a\u064d \u0625\u0644\u064a\u0643\u0645 \u0639\u0646\u062f \u0645\u062c\u064a\u0621 \u0622\u062c\u0627\u0644\u0643\u0645\u060c \u062b\u0645 \u062a\u0631\u062c\u0639\u0648\u0646 \u064a\u0648\u0645 \u0627\u0644\u0628\u0639\u062b \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u0627\u0644\u0639\u0627\u0644\u0645 \u0628\u0645\u0627 \u063a\u0627\u0628 \u0648\u0645\u0627 \u062d\u0636\u0631\u060c \u0641\u064a\u062e\u0628\u0631\u0643\u0645 \u0628\u0623\u0639\u0645\u0627\u0644\u0643\u0645\u060c \u0648\u0633\u064a\u062c\u0627\u0632\u064a\u0643\u0645 \u0639\u0644\u064a\u0647\u0627.","footnotes":null},{"id":"5186","sura":"62","aya":"9","arabic_text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0630\u064e\u0627 \u0646\u064f\u0648\u062f\u0650\u064a\u064e \u0644\u0650\u0644\u0635\u0651\u064e\u0644\u064e\u0648\u0670\u0629\u0650 \u0645\u0650\u0646 \u064a\u064e\u0648\u06e1\u0645\u0650 \u0671\u0644\u06e1\u062c\u064f\u0645\u064f\u0639\u064e\u0629\u0650 \u0641\u064e\u0671\u0633\u06e1\u0639\u064e\u0648\u06e1\u0627\u0652 \u0625\u0650\u0644\u064e\u0649\u0670 \u0630\u0650\u0643\u06e1\u0631\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0630\u064e\u0631\u064f\u0648\u0627\u0652 \u0671\u0644\u06e1\u0628\u064e\u064a\u06e1\u0639\u064e\u06da \u0630\u064e\u0670\u0644\u0650\u0643\u064f\u0645\u06e1 \u062e\u064e\u064a\u06e1\u0631\u065e \u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u0625\u0650\u0646 \u0643\u064f\u0646\u062a\u064f\u0645\u06e1 \u062a\u064e\u0639\u06e1\u0644\u064e\u0645\u064f\u0648\u0646\u064e","translation":"\u064a\u0627 \u0623\u064a\u0647\u0627 \u0627\u0644\u0630\u064a\u0646 \u0635\u062f\u0651\u064e\u0642\u0648\u0627 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u0648\u0639\u0645\u0644\u0648\u0627 \u0628\u0634\u0631\u0639\u0647\u060c \u0625\u0630\u0627 \u0646\u0627\u062f\u0649 \u0627\u0644\u0645\u0624\u0630\u0646 \u0644\u0644\u0635\u0644\u0627\u0629 \u0641\u064a \u064a\u0648\u0645 \u0627\u0644\u062c\u0645\u0639\u0629\u060c \u0641\u0627\u0645\u0636\u0648\u0627 \u0625\u0644\u0649 \u0633\u0645\u0627\u0639 \u0627\u0644\u062e\u0637\u0628\u0629 \u0648\u0623\u062f\u0627\u0621 \u0627\u0644\u0635\u0644\u0627\u0629\u060c \u0648\u0627\u062a\u0631\u0643\u0648\u0627 \u0627\u0644\u0628\u064a\u0639\u060c \u0648\u0643\u0630\u0644\u0643 \u0627\u0644\u0634\u0631\u0627\u0621 \u0648\u062c\u0645\u064a\u0639 \u0645\u0627 \u064a\u064e\u0634\u0652\u063a\u064e\u0644\u064f\u0643\u0645 \u0639\u0646\u0647\u0627\u060c \u0630\u0644\u0643 \u0627\u0644\u0630\u064a \u0623\u064f\u0645\u0631\u062a\u0645 \u0628\u0647 \u062e\u064a\u0631 \u0644\u0643\u0645\u061b \u0644\u0645\u0627 \u0641\u064a\u0647 \u0645\u0646 \u063a\u0641\u0631\u0627\u0646 \u0630\u0646\u0648\u0628\u0643\u0645 \u0648\u0645\u062b\u0648\u0628\u0629 \u0627\u0644\u0644\u0647 \u0644\u0643\u0645\u060c \u0625\u0646 \u0643\u0646\u062a\u0645 \u062a\u0639\u0644\u0645\u0648\u0646 \u0645\u0635\u0627\u0644\u062d \u0623\u0646\u0641\u0633\u0643\u0645 \u0641\u0627\u0641\u0639\u0644\u0648\u0627 \u0630\u0644\u0643. \u0648\u0641\u064a \u0627\u0644\u0622\u064a\u0629 \u062f\u0644\u064a\u0644 \u0639\u0644\u0649 \u0648\u062c\u0648\u0628 \u062d\u0636\u0648\u0631 \u0627\u0644\u062c\u0645\u0639\u0629 \u0648\u0627\u0633\u062a\u0645\u0627\u0639 \u0627\u0644\u062e\u0637\u0628\u0629.","footnotes":null},{"id":"5187","sura":"62","aya":"10","arabic_text":"\u0641\u064e\u0625\u0650\u0630\u064e\u0627 \u0642\u064f\u0636\u0650\u064a\u064e\u062a\u0650 \u0671\u0644\u0635\u0651\u064e\u0644\u064e\u0648\u0670\u0629\u064f \u0641\u064e\u0671\u0646\u062a\u064e\u0634\u0650\u0631\u064f\u0648\u0627\u0652 \u0641\u0650\u064a \u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0671\u0628\u06e1\u062a\u064e\u063a\u064f\u0648\u0627\u0652 \u0645\u0650\u0646 \u0641\u064e\u0636\u06e1\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0671\u0630\u06e1\u0643\u064f\u0631\u064f\u0648\u0627\u0652 \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0643\u064e\u062b\u0650\u064a\u0631\u0657\u0627 \u0644\u0651\u064e\u0639\u064e\u0644\u0651\u064e\u0643\u064f\u0645\u06e1 \u062a\u064f\u0641\u06e1\u0644\u0650\u062d\u064f\u0648\u0646\u064e","translation":"\u0641\u0625\u0630\u0627 \u0633\u0645\u0639\u062a\u0645 \u0627\u0644\u062e\u0637\u0628\u0629\u060c \u0648\u0623\u062f\u0651\u064e\u064a\u062a\u0645 \u0627\u0644\u0635\u0644\u0627\u0629\u060c \u0641\u0627\u0646\u062a\u0634\u0631\u0648\u0627 \u0641\u064a \u0627\u0644\u0623\u0631\u0636\u060c \u0648\u0627\u0637\u0644\u0628\u0648\u0627 \u0645\u0646 \u0631\u0632\u0642 \u0627\u0644\u0644\u0647 \u0628\u0633\u0639\u064a\u0643\u0645\u060c \u0648\u0627\u0630\u0643\u0631\u0648\u0627 \u0627\u0644\u0644\u0647 \u0643\u062b\u064a\u0631\u064b\u0627 \u0641\u064a \u062c\u0645\u064a\u0639 \u0623\u062d\u0648\u0627\u0644\u0643\u0645\u061b \u0644\u0639\u0644\u0643\u0645 \u062a\u0641\u0648\u0632\u0648\u0646 \u0628\u062e\u064a\u0631\u064a \u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0627\u0644\u0622\u062e\u0631\u0629.","footnotes":null},{"id":"5188","sura":"62","aya":"11","arabic_text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0631\u064e\u0623\u064e\u0648\u06e1\u0627\u0652 \u062a\u0650\u062c\u064e\u0670\u0631\u064e\u0629\u064b \u0623\u064e\u0648\u06e1 \u0644\u064e\u0647\u06e1\u0648\u064b\u0627 \u0671\u0646\u0641\u064e\u0636\u0651\u064f\u0648\u0653\u0627\u0652 \u0625\u0650\u0644\u064e\u064a\u06e1\u0647\u064e\u0627 \u0648\u064e\u062a\u064e\u0631\u064e\u0643\u064f\u0648\u0643\u064e \u0642\u064e\u0627\u0653\u0626\u0650\u0645\u0657\u0627\u06da \u0642\u064f\u0644\u06e1 \u0645\u064e\u0627 \u0639\u0650\u0646\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u062e\u064e\u064a\u06e1\u0631\u065e \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u06e1\u0648\u0650 \u0648\u064e\u0645\u0650\u0646\u064e \u0671\u0644\u062a\u0651\u0650\u062c\u064e\u0670\u0631\u064e\u0629\u0650\u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u062e\u064e\u064a\u06e1\u0631\u064f \u0671\u0644\u0631\u0651\u064e\u0670\u0632\u0650\u0642\u0650\u064a\u0646\u064e","translation":"\u0625\u0630\u0627 \u0631\u0623\u0649 \u0628\u0639\u0636 \u0627\u0644\u0645\u0633\u0644\u0645\u064a\u0646 \u062a\u062c\u0627\u0631\u0629 \u0623\u0648 \u0634\u064a\u0626\u064b\u0627 \u0645\u0650\u0646 \u0644\u0647\u0648 \u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0632\u064a\u0646\u062a\u0647\u0627 \u062a\u0641\u0631\u0651\u064e\u0642\u0648\u0627 \u0625\u0644\u064a\u0647\u0627\u060c \u0648\u062a\u0631\u0643\u0648\u0643 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0628\u064a- \u0642\u0627\u0626\u0645\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0628\u0631 \u062a\u062e\u0637\u0628\u060c \u0642\u0644 \u0644\u0647\u0645 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0628\u064a-: \u0645\u0627 \u0639\u0646\u062f \u0627\u0644\u0644\u0647 \u0645\u0646 \u0627\u0644\u062b\u0648\u0627\u0628 \u0648\u0627\u0644\u0646\u0639\u064a\u0645 \u0623\u0646\u0641\u0639 \u0644\u0643\u0645 \u0645\u0646 \u0627\u0644\u0644\u0647\u0648 \u0648\u0645\u0646 \u0627\u0644\u062a\u062c\u0627\u0631\u0629\u060c \u0648\u0627\u0644\u0644\u0647 -\u0648\u062d\u062f\u0647- \u062e\u064a\u0631 \u0645\u064e\u0646 \u0631\u0632\u0642 \u0648\u0623\u0639\u0637\u0649\u060c \u0641\u0627\u0637\u0644\u0628\u0648\u0627 \u0645\u0646\u0647\u060c \u0648\u0627\u0633\u062a\u0639\u064a\u0646\u0648\u0627 \u0628\u0637\u0627\u0639\u062a\u0647 \u0639\u0644\u0649 \u0646\u064a\u0644 \u0645\u0627 \u0639\u0646\u062f\u0647 \u0645\u0646 \u062e\u064a\u0631\u064a \u0627\u0644\u062f\u0646\u064a\u0627 \u0648\u0627\u0644\u0622\u062e\u0631\u0629.","footnotes":null}]}