47\u0645.","footnotes":null},{"id":"5194","sura":"63","aya":"6","arabic_text":"\u0633\u064e\u0648\u064e\u0627\u0653\u0621\u064c \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0623\u064e\u0633\u06e1\u062a\u064e\u063a\u06e1\u0641\u064e\u0631\u06e1\u062a\u064e \u0644\u064e\u0647\u064f\u0645\u06e1 \u0623\u064e\u0645\u06e1 \u0644\u064e\u0645\u06e1 \u062a\u064e\u0633\u06e1\u062a\u064e\u063a\u06e1\u0641\u0650\u0631\u06e1 \u0644\u064e\u0647\u064f\u0645\u06e1 \u0644\u064e\u0646 \u064a\u064e\u063a\u06e1\u0641\u0650\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0644\u064e\u0647\u064f\u0645\u06e1\u06da \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0644\u064e\u0627 \u064a\u064e\u0647\u06e1\u062f\u0650\u064a \u0671\u0644\u06e1\u0642\u064e\u0648\u06e1\u0645\u064e \u0671\u0644\u06e1\u0641\u064e\u0670\u0633\u0650\u0642\u0650\u064a\u0646\u064e","translation":"\u0633\u0648\u0627\u0621 \u0639\u0644\u0649 \u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u0645\u0646\u0627\u0641\u0642\u064a\u0646 \u0623\u0637\u0644\u0628\u062a \u0644\u0647\u0645 \u0627\u0644\u0645\u063a\u0641\u0631\u0629 \u0645\u0646 \u0627\u0644\u0644\u0647 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0631\u0633\u0648\u0644- \u0623\u0645 \u0644\u0645 \u062a\u0637\u0644\u0628 \u0644\u0647\u0645\u060c \u0625\u0646 \u0627\u0644\u0644\u0647 \u0644\u0646 \u064a\u0635\u0641\u062d \u0639\u0646 \u0630\u0646\u0648\u0628\u0647\u0645 \u0623\u0628\u062f\u064b\u0627 ; \u0644\u0625\u0635\u0631\u0627\u0631\u0647\u0645 \u0639\u0644\u0649 \u0627\u0644\u0641\u0633\u0642 \u0648\u0631\u0633\u0648\u062e\u0647\u0645 \u0641\u064a \u0627\u0644\u0643\u0641\u0631. \u0625\u0646 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064a\u0648\u0641\u0651\u0650\u0642 \u0644\u0644\u0625\u064a\u0645\u0627\u0646 \u0627\u0644\u0642\u0648\u0645 \u0627\u0644\u0643\u0627\u0641\u0631\u064a\u0646 \u0628\u0647\u060c \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0646 \u0639\u0646 \u0637\u0627\u0639\u062a\u0647.","footnotes":null},{"id":"5195","sura":"63","aya":"7","arabic_text":"\u0647\u064f\u0645\u064f \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u064a\u064e\u0642\u064f\u0648\u0644\u064f\u0648\u0646\u064e \u0644\u064e\u0627 \u062a\u064f\u0646\u0641\u0650\u0642\u064f\u0648\u0627\u0652 \u0639\u064e\u0644\u064e\u0649\u0670 \u0645\u064e\u0646\u06e1 \u0639\u0650\u0646\u062f\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u062d\u064e\u062a\u0651\u064e\u0649\u0670 \u064a\u064e\u0646\u0641\u064e\u0636\u0651\u064f\u0648\u0627\u0652\u06d7 \u0648\u064e\u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u062e\u064e\u0632\u064e\u0627\u0653\u0626\u0650\u0646\u064f \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0671\u0644\u06e1\u0623\u064e\u0631\u06e1\u0636\u0650 \u0648\u064e\u0644\u064e\u0670\u0643\u0650\u0646\u0651\u064e \u0671\u0644\u06e1\u0645\u064f\u0646\u064e\u0670\u0641\u0650\u0642\u0650\u064a\u0646\u064e \u0644\u064e\u0627 \u064a\u064e\u0641\u06e1\u0642\u064e\u0647\u064f\u0648\u0646\u064e","translation":"\u0647\u0624\u0644\u0627\u0621 \u0627\u0644\u0645\u0646\u0627\u0641\u0642\u0648\u0646 \u0647\u0645 \u0627\u0644\u0630\u064a\u0646 \u064a\u0642\u0648\u0644\u0648\u0646 \u0644\u0623\u0647\u0644 \u00ab\u0627\u0644\u0645\u062f\u064a\u0646\u0629\u00bb : \u0644\u0627 \u062a\u0646\u0641\u0642\u0648\u0627 \u0639\u0644\u0649 \u0623\u0635\u062d\u0627\u0628 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0645\u0646 \u0627\u0644\u0645\u0647\u0627\u062c\u0631\u064a\u0646 \u062d\u062a\u0649 \u064a\u062a\u0641\u0631\u0642\u0648\u0627 \u0639\u0646\u0647. \u0648\u0644\u0644\u0647 \u0648\u062d\u062f\u0647 \u062e\u0632\u0627\u0626\u0646 \u0627\u0644\u0633\u0645\u0648\u0627\u062a \u0648\u0627\u0644\u0623\u0631\u0636 \u0648\u0645\u0627 \u0641\u064a\u0647\u0645\u0627 \u0645\u0646 \u0623\u0631\u0632\u0627\u0642\u060c \u064a\u0639\u0637\u064a\u0647\u0627 \u0645\u0646 \u064a\u0634\u0627\u0621 \u0648\u064a\u0645\u0646\u0639\u