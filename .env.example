# Copy to .env.local and fill in:  Copy-Item .env.example .env.local
# Never commit real values. Nothing here is required: without a database, accounts and sync are off.

# --- App -------------------------------------------------------------------
# Public base URL (used for canonical URLs and metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database: PostgreSQL for USER DATA only (Quran content is static) -------
# Runtime connection. On Neon use the *pooled* connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Migrations (Prisma CLI). On Neon use the *direct* (non-pooled) connection string.
# Optional locally: falls back to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Without DATABASE_URL the app works fully, with accounts and sync switched off.
#
# Local development without Docker (DECISIONS D-062): run `npm run db:dev` in another terminal
# (PGlite on port 5433, data in .cache/pglite-dev) and use:
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"
#   DATABASE_POOL_MAX="1"     # required with PGlite (one shared backend)

# --- Auth: Better Auth (Phase 9) -------------------------------------------------
# Long random secret, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Email: Resend (Phase 9: password reset, optional verification) ------------
# Without a key, development writes account emails to .cache/mail-outbox.jsonl.
# A production server without a key refuses to send unless NOOR_DEV_MAIL_OUTBOX=1 (tests only).
RESEND_API_KEY=""
EMAIL_FROM="Noor <no-reply@example.com>"

# --- Tooling (optional) ---------------------------------------------------------
# Folder for the @swc/core native-binding cache used by the next-intl plugin.
# Default: .cache/swc inside the project (see tooling/swc-native-cache.ts).
# SWC_NATIVE_BINDING_CACHE=""
