{
  "name": "noor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Noor — a Quran-first web app (Mushaf, adhkar, reading tracker, memorization, prayer utilities).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate-if-configured.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:dev": "node scripts/dev-db.ts",
    "sources:fetch": "node scripts/sources/fetch-sources.mjs",
    "sources:check": "node scripts/sources/check-sources.mjs",
    "content:import": "node scripts/import-quran.ts",
    "content:verify": "node scripts/verify-content.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "adhan": "4.4.6",
    "better-auth": "1.7.7",
    "dexie": "4.4.6",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.32.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "6.2.5",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wawoff2": "2.0.1"
  }
}
