{
  "name": "noor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Noor — a Quran-first web app (Mushaf, adhkar, reading tracker, memorization, prayer utilities).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "sources:fetch": "node scripts/sources/fetch-sources.mjs",
    "sources:check": "node scripts/sources/check-sources.mjs",
    "content:import": "node scripts/import-quran.ts",
    "content:verify": "node scripts/verify-content.ts"
  },
  "dependencies": {
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
