  "bismillah": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "ayahs": [
    {"number":1,"text":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":3,"text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":4,"text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":5,"text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":6,"text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":8,"text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":9,"text":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":12,"text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":13,"text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":14,"text":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":15,"text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":16,"text":"ٱلْجَوَارِ ٱلْكُنَّسِ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":17,"text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":18,"text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":19,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":20,"text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":21,"text":"مُّطَاعٍ ثَمَّ أَمِينٍ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":22,"text":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":23,"text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":24,"text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":25,"text":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":26,"text":"فَأَيْنَ تَذْهَبُونَ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":27,"text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":28,"text":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","page":586,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","page":586,"juz":30,"hizb":59,"hizbQuarter":234}
  ]
}
