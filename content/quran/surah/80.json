  "bismillah": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "ayahs": [
    {"number":1,"text":"عَبَسَ وَتَوَلَّىٰٓ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":2,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":3,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":4,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":5,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":7,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":8,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":9,"text":"وَهُوَ يَخْشَىٰ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":10,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":11,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":13,"text":"فِى صُحُفٍ مُّكَرَّمَةٍ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":14,"text":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":15,"text":"بِأَيْدِى سَفَرَةٍ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":16,"text":"كِرَامٍۭ بَرَرَةٍ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":17,"text":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":18,"text":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":19,"text":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":23,"text":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":24,"text":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":25,"text":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":26,"text":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":27,"text":"فَأَنۢبَتْنَا فِيهَا حَبًّا","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":28,"text":"وَعِنَبًا وَقَضْبًا","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":29,"text":"وَزَيْتُونًا وَنَخْلًا","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":30,"text":"وَحَدَآئِقَ غُلْبًا","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":31,"text":"وَفَـٰكِهَةً وَأَبًّا","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":32,"text":"مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":34,"text":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":36,"text":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":37,"text":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":38,"text":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":39,"text":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":40,"text":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":41,"text":"تَرْهَقُهَا قَتَرَةٌ","page":585,"juz":30,"hizb":59,"hizbQuarter":234},
    {"number":42,"text":"أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","page":585,"juz":30,"hizb":59,"hizbQuarter":234}
  ]
}
