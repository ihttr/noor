  "bismillah": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "ayahs": [
    {"number":1,"text":"وَٱلْمُرْسَلَـٰتِ عُرْفًا","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":2,"text":"فَٱلْعَـٰصِفَـٰتِ عَصْفًا","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":3,"text":"وَٱلنَّـٰشِرَٰتِ نَشْرًا","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":4,"text":"فَٱلْفَـٰرِقَـٰتِ فَرْقًا","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":5,"text":"فَٱلْمُلْقِيَـٰتِ ذِكْرًا","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":6,"text":"عُذْرًا أَوْ نُذْرًا","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتْ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتْ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":10,"text":"وَإِذَا ٱلْجِبَالُ نُسِفَتْ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتْ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":12,"text":"لِأَىِّ يَوْمٍ أُجِّلَتْ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":13,"text":"لِيَوْمِ ٱلْفَصْلِ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":14,"text":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":15,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":16,"text":"أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":17,"text":"ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":18,"text":"كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":19,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":20,"text":"أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":21,"text":"فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":22,"text":"إِلَىٰ قَدَرٍ مَّعْلُومٍ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":23,"text":"فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":24,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":25,"text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":26,"text":"أَحْيَآءً وَأَمْوَٰتًا","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":27,"text":"وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":28,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":29,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":30,"text":"ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":31,"text":"لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":32,"text":"إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":33,"text":"كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":34,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":35,"text":"هَـٰذَا يَوْمُ لَا يَنطِقُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":37,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":38,"text":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":40,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":45,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":47,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":49,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232},
    {"number":50,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","page":581,"juz":29,"hizb":58,"hizbQuarter":232}
  ]
}
