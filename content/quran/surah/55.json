    {"number":11,"text":"فِيهَا فَـٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ","page":531,"juz":27,"hizb":54,"hizbQuarter":213},
    {"number":12,"text":"وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ","page":531,"juz":27,"hizb":54,"hizbQuarter":213},
    {"number":13,"text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","page":531,"juz":27,"hizb":54,"hizbQuarter":213},
