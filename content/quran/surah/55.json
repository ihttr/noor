    {"number":4,"text":"عَلَّمَهُ ٱلْبَيَانَ","page":531,"juz":27,"hizb":54,"hizbQuarter":213},
    {"number":5,"text":"ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ","page":531,"juz":27,"hizb":54,"hizbQuarter":213},
    {"number":6,"text":"وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ","page":531,"juz":27,"hizb":54,"hizbQuarter":213},
    {"number":7,"text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ","page":531,"juz":27,"hizb":54,"hizbQuarter":213},
