  "bismillah": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "ayahs": [
    {"number":1,"text":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":2,"text":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":3,"text":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":4,"text":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":5,"text":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":6,"text":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":7,"text":"فَإِذَا بَرِقَ ٱلْبَصَرُ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":8,"text":"وَخَسَفَ ٱلْقَمَرُ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":9,"text":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":10,"text":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":11,"text":"كَلَّا لَا وَزَرَ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":12,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":13,"text":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":14,"text":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":15,"text":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":16,"text":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":17,"text":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":18,"text":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":19,"text":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","page":577,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":20,"text":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":21,"text":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":22,"text":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":24,"text":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":25,"text":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":27,"text":"وَقِيلَ مَنْ ۜ رَاقٍ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":28,"text":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":29,"text":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":30,"text":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":32,"text":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":34,"text":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":35,"text":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":36,"text":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":37,"text":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":38,"text":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":39,"text":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","page":578,"juz":29,"hizb":58,"hizbQuarter":231},
    {"number":40,"text":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ","page":578,"juz":29,"hizb":58,"hizbQuarter":231}
  ]
}
