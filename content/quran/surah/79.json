  "bismillah": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "ayahs": [
    {"number":1,"text":"وَٱلنَّـٰزِعَـٰتِ غَرْقًا","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":2,"text":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":3,"text":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":4,"text":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":5,"text":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":6,"text":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":7,"text":"تَتْبَعُهَا ٱلرَّادِفَةُ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":8,"text":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":9,"text":"أَبْصَـٰرُهَا خَـٰشِعَةٌ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":10,"text":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":11,"text":"أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":12,"text":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":13,"text":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":15,"text":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","page":583,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":16,"text":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":17,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":18,"text":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":19,"text":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":20,"text":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":21,"text":"فَكَذَّبَ وَعَصَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":22,"text":"ثُمَّ أَدْبَرَ يَسْعَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":23,"text":"فَحَشَرَ فَنَادَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":26,"text":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":27,"text":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":28,"text":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":29,"text":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":30,"text":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":31,"text":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":32,"text":"وَٱلْجِبَالَ أَرْسَىٰهَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":33,"text":"مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":35,"text":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":36,"text":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":37,"text":"فَأَمَّا مَن طَغَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":38,"text":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":39,"text":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":40,"text":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":41,"text":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":42,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":43,"text":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233},
    {"number":46,"text":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","page":584,"juz":30,"hizb":59,"hizbQuarter":233}
  ]
}
