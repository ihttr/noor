    {"number":57,"text":"نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":58,"text":"أَفَرَءَيْتُم مَّا تُمْنُونَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":59,"text":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":60,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":61,"text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":62,"text":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":63,"text":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":64,"text":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":65,"text":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ","page":536,"juz":27,"hizb":54,"hizbQuarter":214},
