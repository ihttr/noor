  "bismillah": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "ayahs": [
    {"number":1,"text":"إِذَا وَقَعَتِ ٱلْوَاقِعَةُ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":2,"text":"لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":3,"text":"خَافِضَةٌ رَّافِعَةٌ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":4,"text":"إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":5,"text":"وَبُسَّتِ ٱلْجِبَالُ بَسًّا","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":6,"text":"فَكَانَتْ هَبَآءً مُّنۢبَثًّا","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":7,"text":"وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":8,"text":"فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":9,"text":"وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":10,"text":"وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":11,"text":"أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":12,"text":"فِى جَنَّـٰتِ ٱلنَّعِيمِ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":13,"text":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":14,"text":"وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":15,"text":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":16,"text":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ","page":534,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":17,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":18,"text":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":19,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":20,"text":"وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":21,"text":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":22,"text":"وَحُورٌ عِينٌ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":23,"text":"كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":24,"text":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":25,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":26,"text":"إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":27,"text":"وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":28,"text":"فِى سِدْرٍ مَّخْضُودٍ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":29,"text":"وَطَلْحٍ مَّنضُودٍ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":30,"text":"وَظِلٍّ مَّمْدُودٍ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":31,"text":"وَمَآءٍ مَّسْكُوبٍ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":32,"text":"وَفَـٰكِهَةٍ كَثِيرَةٍ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":33,"text":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
