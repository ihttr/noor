    {"number":40,"text":"وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":41,"text":"وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
