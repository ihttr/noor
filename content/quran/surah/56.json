    {"number":44,"text":"لَّا بَارِدٍ وَلَا كَرِيمٍ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":45,"text":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":46,"text":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":47,"text":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":48,"text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
