    {"number":35,"text":"إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":36,"text":"فَجَعَلْنَـٰهُنَّ أَبْكَارًا","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
    {"number":37,"text":"عُرُبًا أَتْرَابًا","page":535,"juz":27,"hizb":54,"hizbQuarter":214},
