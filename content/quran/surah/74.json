  "bismillah": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
  "ayahs": [
    {"number":1,"text":"يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":2,"text":"قُمْ فَأَنذِرْ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":3,"text":"وَرَبَّكَ فَكَبِّرْ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":4,"text":"وَثِيَابَكَ فَطَهِّرْ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":5,"text":"وَٱلرُّجْزَ فَٱهْجُرْ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":6,"text":"وَلَا تَمْنُن تَسْتَكْثِرُ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":7,"text":"وَلِرَبِّكَ فَٱصْبِرْ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":8,"text":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":9,"text":"فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":10,"text":"عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":11,"text":"ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":12,"text":"وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":13,"text":"وَبَنِينَ شُهُودًا","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":14,"text":"وَمَهَّدتُّ لَهُۥ تَمْهِيدًا","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":15,"text":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":16,"text":"كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":17,"text":"سَأُرْهِقُهُۥ صَعُودًا","page":575,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":18,"text":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":19,"text":"فَقُتِلَ كَيْفَ قَدَّرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":20,"text":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":21,"text":"ثُمَّ نَظَرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":22,"text":"ثُمَّ عَبَسَ وَبَسَرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":23,"text":"ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":24,"text":"فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":25,"text":"إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":26,"text":"سَأُصْلِيهِ سَقَرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":27,"text":"وَمَآ أَدْرَىٰكَ مَا سَقَرُ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":28,"text":"لَا تُبْقِى وَلَا تَذَرُ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":29,"text":"لَوَّاحَةٌ لِّلْبَشَرِ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":30,"text":"عَلَيْهَا تِسْعَةَ عَشَرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":31,"text":"وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":32,"text":"كَلَّا وَٱلْقَمَرِ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":33,"text":"وَٱلَّيْلِ إِذْ أَدْبَرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":34,"text":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":35,"text":"إِنَّهَا لَإِحْدَى ٱلْكُبَرِ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":36,"text":"نَذِيرًا لِّلْبَشَرِ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":37,"text":"لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":38,"text":"كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":39,"text":"إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":40,"text":"فِى جَنَّـٰتٍ يَتَسَآءَلُونَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":41,"text":"عَنِ ٱلْمُجْرِمِينَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":42,"text":"مَا سَلَكَكُمْ فِى سَقَرَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":43,"text":"قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":44,"text":"وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":45,"text":"وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":46,"text":"وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":47,"text":"حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ","page":576,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":48,"text":"فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ","page":577,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":49,"text":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ","page":577,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":50,"text":"كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ","page":577,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":51,"text":"فَرَّتْ مِن قَسْوَرَةٍۭ","page":577,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":52,"text":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً","page":577,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":53,"text":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ","page":577,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":54,"text":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌ","page":577,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":55,"text":"فَمَن شَآءَ ذَكَرَهُۥ","page":577,"juz":29,"hizb":58,"hizbQuarter":230},
    {"number":56,"text":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","page":577,"juz":29,"hizb":58,"hizbQuarter":230}
  ]
}
